<?xml version="1.0" encoding="utf-8"?>
<!--
  A PlayerView com TextureView em vez de SurfaceView. So se escolhe por XML.

  Um SurfaceView e' uma janela aberta no ecra, fora da arvore que o Compose anima:
  nao esbate, nao desliza, nao acompanha a foto que voa — no lugar dele fica um
  buraco preto ate o video acender. Com TextureView o video e' uma textura como
  qualquer outra camada e entra nas transicoes como o resto do ecra.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
